    <xs:key name="groupKey"><xs:selector xpath="d:Grouping/d:Group"/><xs:field xpath="@id"/></xs:key>
    <xs:key name="setKey"><xs:selector xpath="d:Grouping/d:AssignmentSet"/><xs:field xpath="@id"/></xs:key>
    <xs:key name="variableKey"><xs:selector xpath="d:Variables/d:Variable"/><xs:field xpath="@id"/></xs:key>
    <xs:key name="linkKey"><xs:selector xpath="d:Graph/d:Link"/><xs:field xpath="@id"/></xs:key>
    <xs:unique name="answerKey"><xs:selector xpath="d:Respondents/d:Respondent/d:TextAnswer"/><xs:field xpath="@id"/></xs:unique>
    <xs:key name="codeKey"><xs:selector xpath="d:Coding/d:CodeDef"/><xs:field xpath="@id"/></xs:key>
    <xs:keyref name="appliedAnswerRef" refer="d:answerKey"><xs:selector xpath="d:Coding/d:Applied"/><xs:field xpath="@answer"/></xs:keyref>
    <xs:keyref name="appliedCodeRef" refer="d:codeKey"><xs:selector xpath="d:Coding/d:Applied"/><xs:field xpath="@code"/></xs:keyref>
    <xs:key name="respondentKey"><xs:selector xpath="d:Respondents/d:Respondent"/><xs:field xpath="@respid"/></xs:key>
    <xs:unique name="itemResultsUnique"><xs:selector xpath="d:Results/d:ItemResults"/><xs:field xpath="@item"/></xs:unique>
    <xs:unique name="flagUnique"><xs:selector xpath="d:Results/d:SignificanceFlags/d:Flag"/><xs:field xpath="@cite"/></xs:unique>

    <!-- references -->
    <xs:keyref name="itemScaleRef" refer="d:scaleKey"><xs:selector xpath="d:Instrument/d:Threads/d:Thread/d:Item"/><xs:field xpath="@scale"/></xs:keyref>
    <xs:keyref name="ruleTargetRef" refer="d:itemKey"><xs:selector xpath="d:Instrument/d:RoutingRules/d:Rule/d:Target"/><xs:field xpath="@item"/></xs:keyref>
