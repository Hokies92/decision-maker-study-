    <xs:key name="ruleKey"><xs:selector xpath="d:Instrument/d:RoutingRules/d:Rule"/><xs:field xpath="@id"/></xs:key>
    <xs:key name="nodeKey"><xs:selector xpath="d:Population/d:StakeholderHierarchy/d:Node"/><xs:field xpath="@id"/></xs:key>
