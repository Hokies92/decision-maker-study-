    <xs:keyref name="flagItemRef" refer="d:itemKey"><xs:selector xpath="d:Results/d:SignificanceFlags/d:Flag"/><xs:field xpath="@item"/></xs:keyref>
    <xs:keyref name="flagThreadRef" refer="d:threadKey"><xs:selector xpath="d:Results/d:SignificanceFlags/d:Flag"/><xs:field xpath="@thread"/></xs:keyref>
    <xs:keyref name="flagDimensionRef" refer="d:dimensionKey"><xs:selector xpath="d:Results/d:SignificanceFlags/d:Flag"/><xs:field xpath="@dimension"/></xs:keyref>
    <xs:keyref name="variableItemRef" refer="d:itemKey"><xs:selector xpath="d:Variables/d:Variable"/><xs:field xpath="@item"/></xs:keyref>
    <xs:keyref name="variableScaleRef" refer="d:scaleKey"><xs:selector xpath="d:Variables/d:Variable"/><xs:field xpath="@scale"/></xs:keyref>
    <xs:keyref name="linkFromThreadRef" refer="d:threadKey"><xs:selector xpath="d:Graph/d:Link"/><xs:field xpath="@fromThread"/></xs:keyref>
